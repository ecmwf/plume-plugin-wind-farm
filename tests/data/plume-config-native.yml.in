plugins:
  - name: WindFarmPlugin
    lib: wind_farm_plugin
    parameters:
      -
        - name: "u"
          type: "ATLAS_FIELD"
          height: &wind_field_height 110
        - name: "v"
          type: "ATLAS_FIELD"
          height: *wind_field_height
    core-config:
      wind_farm_model:
        name: jensen
        kw: 0.04
      wind_field_height: *wind_field_height
      compute_power: true
      export_wind_box: true
      export_wind_turbine_power: true
      wind_farm_box:
        lon_min: 6.900
        lat_min: 54.900
        lon_max: 7.100
        lat_max: 55.100
        n_lon: 10
        n_lat: 10
      wind_turbines_filename: "@native_dummy_wind_farm_yml@"
